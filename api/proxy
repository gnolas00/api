export default async function handler(req, res) {
    // 1. Immediately set permissive CORS headers
    res.setHeader('Access-Control-Allow-Origin', '*');
    res.setHeader('Access-Control-Allow-Methods', 'GET, OPTIONS');
    res.setHeader('Access-Control-Allow-Headers', 'Content-Type');

    // Handle preflight requests
    if (req.method === 'OPTIONS') {
        return res.status(200).end();
    }

    const { des, dist, limit } = req.query;
    
    // Determine which NASA endpoint to call
    let baseUrl = "https://ssd-api.jpl.nasa.gov/";
    let endpoint = "";

    if (des) {
        // Specific object search (SBDB)
        endpoint = `sbdb.api?sstr=${encodeURIComponent(des)}`;
    } else if (dist) {
        // Close approach scan (CAD)
        const limitParam = limit ? `&limit=${encodeURIComponent(limit)}` : "&limit=5";
        
        // NASA requires a date-min so it doesn't try to send 100 years of data at once
        const today = new Date().toISOString().split('T')[0];
        endpoint = `cad.api?dist-max=${encodeURIComponent(dist)}&date-min=${today}${limitParam}`;
    } else {
        return res.status(400).json({ error: "Missing parameters: provide 'des' or 'dist'" });
    }

    try {
        // 2. Add custom headers to bypass NASA's data center bot-blocking firewall
        const response = await fetch(baseUrl + endpoint, {
            headers: {
                'User-Agent': 'Nolasco-Productions-App/1.0',
                'Accept': 'application/json'
            }
        });
        
        if (!response.ok) {
            const errorText = await response.text();
            return res.status(response.status).json({ 
                error: "NASA API rejected the request.", 
                details: errorText 
            });
        }
        
        const data = await response.json();
        return res.status(200).json(data);
        
    } catch (error) {
        return res.status(500).json({ 
            error: "Failed to fetch from NASA JPL servers.",
            message: error.toString() 
        });
    }
}
